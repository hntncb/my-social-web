{
  "name": "project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:unit": "node --test test/unit/**/*.test.js",
    "test:unit:watch": "node --test --watch test/unit/**/*.test.js",
    "test:integration": "docker compose run --rm api-test",
    "test:integration:internal": "npm run db:up && node --test test/integration/**/*.test.js --test-concurrency=1",
    "test:integration:debug": "docker compose run --rm -p 9229:9229 api-test node --inspect-brk=0.0.0.0:9229 --test",
    "test": "npm run test:unit && npm run test:integration",
    "db:new": "npx dbmate new",
    "db:up": "npx dbmate up",
    "db:down": "npx dbmate down",
    "db:status": "npx dbmate status",
    "prepare": "husky"
  },
  "keywords": [],
