  "type": "module",
  "devDependencies": {
    "dbmate": "^2.35.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
